      "source": [
        "###Example 3"
        "Scrapes the names of the main courses of Data Analytics from W3Schools, and prints their count"
      ],
      "metadata": {
        "id": "P8vxVOR9r-j2"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "import scrapy\n",
        "from scrapy import Selector\n",
        "import requests\n",
        "\n",
        "url='https://w3schools.com'\n",
        "html = requests.get(url).content\n",
        "\n",
        "sel = Selector(text=html)\n",
        "\n",
        "s = sel.css('div#tutorials_data_analytics_links_list_desktop')\\\n",
        "       .css('div[data-category=\"data_analytics\"] > a:nth-of-type(1)')\\\n",
        "       .css(':not(span)::text').extract()\n",
        "s = [i.strip() for i in s if i.strip() != '']"
      ],
      "metadata": {
        "id": "tk1w2Xh02Kb7"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "print(f\"#courses = {len(s)}\")\n",
        "print(s)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "SEprxdDgIEQV",
        "outputId": "0b4ad330-9429-4784-df8a-0453d158c7ca"
      },
