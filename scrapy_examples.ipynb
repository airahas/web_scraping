    {
      "cell_type": "markdown",
      "source": [
        "###Example 4"
        "Scrapes Data Analytics courses names and links from W3Schools using Scrapy Spider"
        "(Spiders are beneficial when you need scalable, asynchronous crawling with built-in request scheduling, retries, and easy link-following across many pages.)"
      ],
      "metadata": {
        "id": "Wlpfg6fS-Omc"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "import scrapy\n",
        "\n",
        "class Extract_DA_Courses(scrapy.Spider):\n",
        "  name='course_spider'\n",
        "  url='https://w3schools.com'\n",
        "\n",
        "  def start_requests(self):\n",
        "    yield scrapy.Request(url=self.url, callback=self.parse)\n",
        "\n",
        "  def parse(self, response):\n",
        "    courses = response.css('div#tutorials_data_analytics_links_list_desktop')\\\n",
        "                .css('div[data-category=\"data_analytics\"] > a:nth-of-type(1)')\\\n",
        "                .css(':not(span)::text').extract()\n",
        "    links = response.css('div#tutorials_data_analytics_links_list_desktop')\\\n",
        "                .css('div[data-category=\"data_analytics\"] > a:nth-of-type(1)')\\\n",
        "                .css('::attr(href)').extract()\n",
        "    da_course_links['Course'] = [c.strip() for c in courses if c.strip() != '']\n",
        "    da_course_links['URL'] = [self.url+link for link in links]"
      ],
      "metadata": {
        "id": "ZRO5Wjko0nFr"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "from scrapy.crawler import CrawlerProcess\n",
        "\n",
        "# Initialize the dictionary of DA courses and their links\n",
        "da_course_links = {'Course': [], 'URL': []}\n",
        "\n",
        "# Run the Spider\n",
        "process = CrawlerProcess()\n",
        "process.crawl(Extract_DA_Courses)\n",
        "process.start()"
      ],
      "metadata": {
        "id": "f74UFW1nvQ3F"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "import pandas as pd\n",
        "df = pd.DataFrame.from_dict(da_course_links)\n",
        "df"
      ],
