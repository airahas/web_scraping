        "###Example 1"
        "Extracts the text content from all <p> (paragraph) elements in a given HTML snippet"
      ],
      "metadata": {
        "id": "yOR4xPA0HYom"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "import scrapy\n",
        "from scrapy import Selector\n",
        "html = '''<html>\n",
        "            <body>\n",
        "              <div class=\"hello world\">\n",
        "                <p>Hello World!</p>\n",
        "              </div>\n",
        "              <p>Enjoy Datacamp</p>\n",
        "            </body>\n",
        "          </html>'''\n",
        "sel = Selector(text=html)\n",
        "sel.xpath('//p/text()').extract()"
      ],
